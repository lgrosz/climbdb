BEGIN;
SELECT plan(36);

SET search_path TO climb,public;

SELECT has_table( 'formations' );

SELECT has_column( 'formations', 'id' );
SELECT col_type_is( 'formations', 'id', 'uuid' );
SELECT col_is_pk( 'formations', 'id' );

SELECT has_column( 'formations', 'slug' );
SELECT col_type_is( 'formations', 'slug', 'text' );
SELECT col_is_null( 'formations', 'slug' );
SELECT col_is_unique( 'formations', 'slug' );

SELECT has_column( 'formations', 'name' );
SELECT col_type_is( 'formations', 'name', 'text' );
SELECT col_is_null( 'formations', 'name' );

SELECT has_column( 'formations', 'description' );
SELECT col_type_is( 'formations', 'description', 'text' );
SELECT col_is_null( 'formations', 'description' );

SELECT has_column( 'formations', 'geom' );
SELECT col_type_is( 'formations', 'geom', 'geometry(Geometry,4326)' );
SELECT col_is_null( 'formations', 'geom' );

SELECT has_column( 'formations', 'region_id' );
SELECT col_type_is( 'formations', 'region_id', 'uuid' );
SELECT col_is_null( 'formations', 'region_id' );
SELECT fk_ok( 'formations', 'region_id', 'regions', 'id' );

SELECT has_column( 'formations', 'crag_id' );
SELECT col_type_is( 'formations', 'crag_id', 'uuid' );
SELECT col_is_null( 'formations', 'crag_id' );
SELECT fk_ok( 'formations', 'crag_id', 'crags', 'id' );

SELECT has_column( 'formations', 'sector_id' );
SELECT col_type_is( 'formations', 'sector_id', 'uuid' );
SELECT col_is_null( 'formations', 'sector_id' );
SELECT fk_ok( 'formations', 'sector_id', 'sectors', 'id' );

-- For the "at_most_one_parent" constraint
SELECT has_check( 'formations' );

SELECT has_column( 'formations', 'rank' );
SELECT col_type_is( 'formations', 'rank', 'integer' );
SELECT col_is_null( 'formations', 'rank' );

-- For the "rank_requires_parent" constraint
INSERT INTO climb.crags (id, name) VALUES ('00000000-0000-7000-8000-000000000002', 'test crag');

SELECT throws_ok(
    $$ INSERT INTO climb.formations (name, rank) VALUES ('unplaced', 1) $$,
    '23514', NULL,
    'a parentless formation cannot carry a rank'
);
SELECT lives_ok(
    $$ INSERT INTO climb.formations (name) VALUES ('unplaced') $$,
    'a parentless formation may exist without a rank'
);
SELECT lives_ok(
    $$ INSERT INTO climb.formations (name, crag_id, rank)
       VALUES ('placed', '00000000-0000-7000-8000-000000000002', 1) $$,
    'a formation with a parent may carry a rank'
);

SELECT * FROM finish();
ROLLBACK;
