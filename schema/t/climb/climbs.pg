BEGIN;
SELECT plan(40);

SET search_path TO climb,public;

SELECT has_table( 'climbs' );

SELECT has_column( 'climbs', 'id' );
SELECT col_type_is( 'climbs', 'id', 'uuid' );
SELECT col_is_pk( 'climbs', 'id' );

SELECT has_column( 'climbs', 'slug' );
SELECT col_type_is( 'climbs', 'slug', 'text' );
SELECT col_is_null( 'climbs', 'slug' );
SELECT col_is_unique( 'climbs', 'slug' );

SELECT has_column( 'climbs', 'name' );
SELECT col_type_is( 'climbs', 'name', 'text' );
SELECT col_is_null( 'climbs', 'name' );

SELECT has_column( 'climbs', 'description' );
SELECT col_type_is( 'climbs', 'description', 'text' );
SELECT col_is_null( 'climbs', 'description' );

SELECT has_column( 'climbs', 'grade' );
SELECT col_type_is( 'climbs', 'grade', 'text' );
SELECT col_is_null( 'climbs', 'grade' );

SELECT has_column( 'climbs', 'region_id' );
SELECT col_type_is( 'climbs', 'region_id', 'uuid' );
SELECT col_is_null( 'climbs', 'region_id' );
SELECT fk_ok( 'climbs', 'region_id', 'regions', 'id' );

SELECT has_column( 'climbs', 'crag_id' );
SELECT col_type_is( 'climbs', 'crag_id', 'uuid' );
SELECT col_is_null( 'climbs', 'crag_id' );
SELECT fk_ok( 'climbs', 'crag_id', 'crags', 'id' );

SELECT has_column( 'climbs', 'sector_id' );
SELECT col_type_is( 'climbs', 'sector_id', 'uuid' );
SELECT col_is_null( 'climbs', 'sector_id' );
SELECT fk_ok( 'climbs', 'sector_id', 'sectors', 'id' );

SELECT has_column( 'climbs', 'formation_id' );
SELECT col_type_is( 'climbs', 'formation_id', 'uuid' );
SELECT col_is_null( 'climbs', 'formation_id' );
SELECT fk_ok( 'climbs', 'formation_id', 'formations', 'id' );

-- For the "at_most_one_parent" constraint
SELECT has_check( 'climbs' );

SELECT has_column( 'climbs', 'rank' );
SELECT col_type_is( 'climbs', 'rank', 'integer' );
SELECT col_is_null( 'climbs', 'rank' );

-- For the "rank_requires_parent" constraint
INSERT INTO climb.crags (id, name) VALUES ('00000000-0000-7000-8000-000000000002', 'test crag');

SELECT throws_ok(
    $$ INSERT INTO climb.climbs (name, rank) VALUES ('unplaced', 1) $$,
    '23514', NULL,
    'a parentless climb cannot carry a rank'
);
SELECT lives_ok(
    $$ INSERT INTO climb.climbs (name) VALUES ('unplaced') $$,
    'a parentless climb may exist without a rank'
);
SELECT lives_ok(
    $$ INSERT INTO climb.climbs (name, crag_id, rank)
       VALUES ('placed', '00000000-0000-7000-8000-000000000002', 1) $$,
    'a climb with a parent may carry a rank'
);

SELECT * FROM finish();
ROLLBACK;
